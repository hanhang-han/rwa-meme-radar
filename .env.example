# Copy to .env; keep real credentials local. Node >= 22.13 required.
OKX_API_KEY=
OKX_SECRET_KEY=
OKX_PASSPHRASE=
BINANCE_API_KEY=
COINGECKO_API_KEY=
BLOCKSCOUT_API_KEY=
EODHD_API_TOKEN=
PORT=3456
# Local protective ceilings (not the account's official quotas). Retries count.
OKX_DAILY_REQUEST_LIMIT=8000
OKX_ROUND_REQUEST_LIMIT=70
OKX_BACKGROUND_RESERVE=1200
OKX_CRITICAL_RESERVE=400
# Optional enrichment budgets. Public CoinGecko and DexScreener use batches.
BLOCKSCOUT_ROUND_LIMIT=10
# Public fallback stays below GeckoTerminal's shared-IP rate window.
COINGECKO_INFO_ROUND_LIMIT=1
# Effective cap is min(this value, the entitlement returned by /api/user).
# A free plan does not unlock intraday references or real-time stocks.
EODHD_DAILY_SYMBOL_LIMIT=20
EODHD_ROUND_SYMBOL_LIMIT=20
OKX_REQUEST_INTERVAL_MS=500
DEEPSEEK_API_KEY=
# Public market streams are shared server-side. They never use trading keys.
CHAIN_STREAM_ENABLED=true
XLAYER_WS_URLS=wss://ws.xlayer.tech,wss://xlayerws.okx.com
BSC_WS_URLS=wss://bsc-rpc.publicnode.com
ROBINHOOD_WS_URLS=wss://robinhood-rpc.publicnode.com
# Optional provider-specific HTTP endpoints for bounded block replay.
# XLAYER_STREAM_RPC=https://xlayerrpc.okx.com
# BSC_STREAM_RPC=https://bsc-rpc.publicnode.com
# ROBINHOOD_STREAM_RPC=https://robinhood-rpc.publicnode.com
